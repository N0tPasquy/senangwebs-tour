{
  "name": "senangwebs-tour",
  "version": "1.0.22",
  "type": "module",
  "description": "VR 360° virtual tour system with visual editor and viewer library",
  "main": "dist/swt.cjs",
  "module": "dist/swt.esm.js",
  "browser": "dist/swt.js",
  "exports": {
    ".": {
      "import": "./dist/swt.esm.js",
      "require": "./dist/swt.cjs",
      "browser": "./dist/swt.js",
      "default": "./dist/swt.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "serve": "http-server -p 8089 -c-1",
    "serve:https": "http-server -S -C cert.pem -K key.pem -p 8089 -c-1",
    "test": "node tests/test-gaze-navigation.js"
  },
  "keywords": [
    "aframe",
    "virtual-tour",
    "360",
    "panorama",
    "vr",
    "editor"
  ],
  "author": "a-hakim",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "http-server": "^14.1.1",
    "postcss-import": "^16.1.1",
    "rollup": "^4.9.6",
    "rollup-plugin-postcss": "^4.0.2",
    "terser": "^5.44.0"
  },
  "peerDependencies": {
    "aframe": "^1.7.1"
  },
  "dependencies": {
    "@bookklik/senangstart-icons": "^1.0.4"
  }
}
